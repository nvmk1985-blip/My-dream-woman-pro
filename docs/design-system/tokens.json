      "card": { "$type": "color", "$value": "#11191C" },
      "cardElevated": { "$type": "color", "$value": "#1B292E" }
    },
    "brand": {
      "gold": { "$type": "color", "$value": "#D4AF6A" },
      "goldBright": { "$type": "color", "$value": "#F4D58D" },
      "goldLight": { "$type": "color", "$value": "#FFE8B0" },
      "goldDark": { "$type": "color", "$value": "#9B773A" },
      "cyan": { "$type": "color", "$value": "#55DDF5" },
      "cyanBright": { "$type": "color", "$value": "#80EEFF" },
