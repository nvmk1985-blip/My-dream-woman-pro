    },
    "text": {
      "primary": { "$type": "color", "$value": "#F5F1E8" },
      "secondary": { "$type": "color", "$value": "#C8D0D1" },
      "tertiary": { "$type": "color", "$value": "#96A5A8" },
      "muted": { "$type": "color", "$value": "#718084" },
      "disabled": { "$type": "color", "$value": "#505B5E" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#29373B" },
      "subtle": { "$type": "color", "$value": "#1C292D" },
      "gold": { "$type": "color", "$value": "#B89555" },
      "cyan": { "$type": "color", "$value": "#278EA3" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#55D6A0" },
      "warning": { "$type": "color", "$value": "#F2C66D" },
      "error": { "$type": "color", "$value": "#FF7D86" },
      "info": { "$type": "color", "$value": "#63BFF2" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "typography": {
    "pageTitle": { "$type": "fontSize", "$value": "26px" },
    "sectionHeading": { "$type": "fontSize", "$value": "20px" },
    "cardTitle": { "$type": "fontSize", "$value": "17px" },
    "body": { "$type": "fontSize", "$value": "15px" },
    "supporting": { "$type": "fontSize", "$value": "13px" },
    "metadata": { "$type": "fontSize", "$value": "12px" },
    "latinFontFamily": { "$type": "fontFamily", "$value": ["Inter", "sans-serif"] },
    "tamilFontFamily": { "$type": "fontFamily", "$value": ["Inter", "Noto Sans Tamil", "sans-serif"] }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "10px" }
  },
  "effect": {
    "goldGlow": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(212, 175, 106, 0.24)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "cyanGlow": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(85, 221, 245, 0.24)",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "14px",
        "spread": "0px"
      }
    }
  }
